project_name = "data-platform"
environment  = "dev"
aws_region   = "us-east-1"
owner        = "data-engineering"

artifact_bucket_force_destroy      = true
enable_artifact_bucket_versioning  = false

tags = {
  CostCenter = "data-platform"
}

# --- lab-storage (Sesión 03: S3, RDS, DynamoDB, Athena) ---

# Required: your own public IP in CIDR form, e.g. "203.0.113.5/32".
# Find it with: curl -s https://checkip.amazonaws.com
student_ip_cidr = "REPLACE-WITH-YOUR-IP/32"

# Required: a strong password for the RDS master user (8-128 chars, no
# "/", '"', "@" or spaces). This file is gitignored (*.tfvars), so it is
# safe to put the real value here directly.
rds_db_password = "REPLACE-WITH-A-STRONG-PASSWORD"
