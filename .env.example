# Copy this file to .env.credentials and replace the placeholder values locally.
# Do not commit real AWS credentials.

AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key

# Optional, only needed for temporary credentials.
AWS_SESSION_TOKEN=

# Keep this aligned with infra/terraform.tfvars unless you intentionally
# override the Terraform variable.
AWS_DEFAULT_REGION=us-east-1

# RDS connection (Sesión 03 lab). Values come from `terraform output` in
# infra/ and the rds_db_password you set in terraform.tfvars.
RDS_ENDPOINT=
RDS_DB_NAME=
RDS_USERNAME=
RDS_PASSWORD=
